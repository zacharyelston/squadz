#!/bin/sh /etc/rc.common
# procd service for squadz-server on an OpenMANET (OpenWrt) node.
# Install as /etc/init.d/squadz, then: /etc/init.d/squadz enable && /etc/init.d/squadz start

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/squadz-server
CONF=/etc/squadz/squadz.env

start_service() {
	mkdir -p /etc/squadz

	procd_open_instance
	procd_set_param command "$PROG"
	# Defaults; anything in $CONF overrides them.
	# 8080/8081 belong to the openmanetd web UI, so stay clear of those.
	procd_set_param env \
		HOST=0.0.0.0 \
		PORT=8090 \
		TLS_PORT=8443 \
		TLS_CERT=/etc/squadz/cert.pem \
		TLS_KEY=/etc/squadz/key.pem \
		TILE_URL=none \
		RUST_LOG=info
	if [ -f "$CONF" ]; then
		while IFS= read -r line; do
			case "$line" in
				''|\#*) ;;
				*=*) procd_append_param env "$line" ;;
			esac
		done < "$CONF"
	fi
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
