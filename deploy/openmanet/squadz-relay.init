#!/bin/sh /etc/rc.common
# procd service for squadz-relay on an OpenMANET (OpenWrt) node.
# Install as /etc/init.d/squadz-relay, then:
#   /etc/init.d/squadz-relay enable && /etc/init.d/squadz-relay start

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/squadz-relay
HOME_DIR=/etc/squadz-relay
CONF=$HOME_DIR/relay.env

start_service() {
	mkdir -p "$HOME_DIR"
	chmod 700 "$HOME_DIR"

	procd_open_instance
	procd_set_param command "$PROG"
	# Defaults; anything in $CONF overrides them.
	# 8080 and 8081 belong to the openmanetd web UI, so stay clear of those.
	procd_set_param env \
		RELAY_LISTEN=0.0.0.0:8443 \
		RELAY_DB=$HOME_DIR/relay.db \
		RELAY_TLS_DIR=$HOME_DIR
	if [ -f "$CONF" ]; then
		while IFS= read -r line; do
			case "$line" in
				''|\#*) ;;
				*=*) procd_append_param env "$line" ;;
			esac
		done < "$CONF"
	fi
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
