# /etc/squadz/squadz.env - one KEY=value per line, no quotes.

# Names and addresses phones will type to reach this node. They go into the
# generated HTTPS certificate; delete /etc/squadz/cert.pem and key.pem and
# restart after changing this.
TLS_HOSTS=10.41.253.10,squadz.local

# Admin dashboard password (http://<node>:8090/). Random on every start if unset.
DASHBOARD_PASSWORD=change-me

# Offline basemap: a folder of tiles laid out as {z}/{x}/{y}.png.
# Remove TILE_URL=none (below) when you set this.
#TILES_DIR=/etc/squadz/tiles
#TILE_MAX_NATIVE_ZOOM=14
#TILE_ATTRIBUTION=© OpenStreetMap contributors

# No basemap: members are drawn on a plain background.
TILE_URL=none
