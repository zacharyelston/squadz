# /etc/squadz/squadz.env - one KEY=value per line, no quotes.

# Names and addresses of this node. They go into the server's certificate and
# the first one is used for the pairing code printed in the log. Phones check
# the server's key, not these names, so changing this never unpairs a phone.
TLS_HOSTS=10.41.253.10,squadz.local

# Password for the operator's page (http://<node>:8090/), which hands out
# pairing codes. Without it, anyone on the mesh who opens the page can pair.
DASHBOARD_PASSWORD=change-me

# Offline map: a folder of tiles laid out as {z}/{x}/{y}.png. Phones fetch
# them through the server and keep them. Without it the apps use the phone's
# own maps, which need internet.
#TILES_DIR=/etc/squadz/tiles
#TILE_MAX_ZOOM=14
#TILE_ATTRIBUTION=© OpenStreetMap contributors

# Seconds without a report before a member is shown as stale.
#LOCATION_TTL_SECS=300
