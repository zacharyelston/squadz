# /etc/squadz-relay/relay.env - one KEY=value per line, no quotes.
# Everything here is optional: with no file at all the relay listens on 8443
# and keeps its certificate and its records in /etc/squadz-relay.

# Names and addresses to put in the certificate the relay makes for itself on
# its first start. Phones don't check them (they hold the certificate's
# fingerprint instead); they are for other tools. Changing this later does
# nothing: the certificate is made once and kept.
RELAY_TLS_HOSTS=10.41.253.10

# Where to listen. 8080 and 8081 are the openmanetd web UI's.
#RELAY_LISTEN=0.0.0.0:8443
